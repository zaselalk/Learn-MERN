# Copy this file to .env and fill in your values.

PORT=5000

# Local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/unifeed

# MongoDB Atlas (paste your connection string, then add /unifeed before the ?)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/unifeed?retryWrites=true&w=majority
